{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boardprep://schemas/source-readiness.schema.json",
  "title": "BoardPrep per-leaf source readiness records",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "leaf_id", "board_id", "official_area_id", "leaf_name",
      "current_question_count", "deficit_to_5", "deficit_to_10", "deficit_to_20",
      "source_ids", "source_count", "primary_source_count", "source_authority",
      "source_currentness", "source_scope_fit", "source_conflict_status",
      "study_material_ids", "study_material_count", "study_coverage",
      "study_source_traceability", "supported_depth_min", "supported_depth_max",
      "distinct_content_families", "distinct_content_family_count",
      "safe_headroom_min", "safe_headroom_preferred", "safe_headroom_max",
      "allowed_scope", "excluded_scope", "limitations", "readiness",
      "readiness_reason", "review_reason", "defer_reason", "max_new_questions",
      "planned_new_questions", "evidence_hash", "reviewed_at_batch"
    ],
    "properties": {
      "leaf_id": {"type": "string", "minLength": 1},
      "board_id": {"const": "criminologist"},
      "official_area_id": {"type": "string", "minLength": 1},
      "leaf_name": {"type": "string", "minLength": 1},
      "current_question_count": {"type": "integer", "minimum": 0},
      "deficit_to_5": {"type": "integer", "minimum": 0},
      "deficit_to_10": {"type": "integer", "minimum": 0},
      "deficit_to_20": {"type": "integer", "minimum": 0},
      "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "source_count": {"type": "integer", "minimum": 0},
      "primary_source_count": {"type": "integer", "minimum": 0},
      "source_authority": {"enum": ["STRONG", "ADEQUATE", "WEAK", "NONE", "UNKNOWN"]},
      "source_currentness": {"enum": ["CURRENT", "CURRENT_WITH_LIMITS", "SUPERSEDED", "FUTURE_EFFECTIVE", "CONFLICTING", "UNKNOWN", "NOT_TIME_SENSITIVE"]},
      "source_scope_fit": {"enum": ["DIRECT", "STRONG", "PARTIAL", "INDIRECT", "NONE", "UNKNOWN"]},
      "source_conflict_status": {"enum": ["NONE", "RESOLVED", "MATERIAL_UNRESOLVED", "UNKNOWN"]},
      "study_material_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "study_material_count": {"type": "integer", "minimum": 0},
      "study_coverage": {"enum": ["COMPLETE", "SUFFICIENT", "PARTIAL", "MISSING", "INVALID", "UNKNOWN"]},
      "study_source_traceability": {"enum": ["COMPLETE", "PARTIAL", "BROKEN", "NONE", "UNKNOWN"]},
      "supported_depth_min": {"type": "integer", "minimum": 1, "maximum": 5},
      "supported_depth_max": {"type": "integer", "minimum": 1, "maximum": 5},
      "distinct_content_families": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "distinct_content_family_count": {"type": "integer", "minimum": 0},
      "safe_headroom_min": {"type": "integer", "minimum": 0},
      "safe_headroom_preferred": {"type": "integer", "minimum": 0},
      "safe_headroom_max": {"type": "integer", "minimum": 0},
      "allowed_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "excluded_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "readiness": {"enum": ["READY", "READY_WITH_LIMITS", "REVIEW", "DEFER"]},
      "readiness_reason": {"type": "string"},
      "review_reason": {"type": "string"},
      "defer_reason": {"type": "string"},
      "max_new_questions": {"type": "integer", "minimum": 0},
      "planned_new_questions": {"type": "integer", "minimum": 0},
      "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "reviewed_at_batch": {"const": 641}
    },
    "additionalProperties": true
  }
}
