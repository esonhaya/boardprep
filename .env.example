APP_ENV=production
APP_DEBUG=false
# APP_DEBUG may only be enabled with APP_ENV=development or testing.
APP_TIMEZONE=UTC
APP_MEMORY_LIMIT=512M

DB_DRIVER=json
# Experimental account preview is available only outside production and is
# deliberately disabled by default. Never enable public accounts from this flag.
BOARDPREP_ACCOUNTS_ENABLED=false
# APP_STORAGE_PATH=/absolute/path/to/writable/storage
# DB_SQLITE_PATH=/absolute/path/to/writable/boardprep.sqlite
# APP_PUBLIC_PATH=/absolute/path/to/the/actual/document-root
# APP_PUBLIC_PATH is optional and is used only by deployment preflight.

# Supply and owner-review deployment-specific privacy terms before public launch.
# PRIVACY_OPERATOR_NAME=
# PRIVACY_OPERATOR_CONTACT=
# PRIVACY_RETENTION_NOTICE=
# PRIVACY_HOSTING_NOTICE=
# PRIVACY_TERMS_APPROVED=false

# MySQL is not a supported production profile for this release.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boardprep
DB_USERNAME=
DB_PASSWORD=
