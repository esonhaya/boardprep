APP_ENV=production
APP_DEBUG=false
# APP_DEBUG may only be enabled with APP_ENV=development or testing.
APP_TIMEZONE=UTC
APP_MEMORY_LIMIT=512M

DB_DRIVER=json
# APP_STORAGE_PATH=/absolute/path/to/writable/storage
# DB_SQLITE_PATH=/absolute/path/to/writable/boardprep.sqlite
# APP_PUBLIC_PATH=/absolute/path/to/the/actual/document-root
# APP_PUBLIC_PATH is optional and is used only by deployment preflight.

# MySQL is not a supported production profile for this release.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boardprep
DB_USERNAME=
DB_PASSWORD=
