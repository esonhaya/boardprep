{
    "product": "BoardPrep",
    "product_version": "1.0.1",
    "release_tag": "v1.0.1",
    "php_min_version": "8.1.0",
    "php_memory_limit": "512M",
    "required_extensions": [
        "json",
        "session",
        "pdo",
        "mbstring"
    ],
    "optional_extensions": [
        "pdo_sqlite",
        "zip"
    ],
    "document_root": "public",
    "front_controller": "public/index.php",
    "rewrite_required": true,
    "config_required": [
        "APP_ENV",
        "APP_DEBUG",
        "APP_TIMEZONE",
        "DB_DRIVER"
    ],
    "writable_paths": [
        "storage"
    ],
    "canonical_content": [
        "storage/boards.json",
        "storage/subjects.json",
        "storage/questions.json",
        "storage/question-eligibility.json",
        "storage/study-materials.json",
        "storage/study-lessons.json",
        "storage/study-question-links.json",
        "storage/taxonomy/domains.json",
        "storage/taxonomy/topics.json",
        "storage/taxonomy/concepts.json"
    ],
    "study_resources": {
        "lesson_registry": "storage/study-lessons.json",
        "generated_pdf_directory": "public/study-resources",
        "generator_command": "php tools/generate-study-pdfs.php --check"
    },
    "json_mutable_stores": [
        "attempts.json",
        "weakness.json",
        "question-statistics.json",
        "flashcard_state.json"
    ],
    "json_optional_mutable_stores": [
        "blueprints.json"
    ],
    "account_preview": {
        "private_storage": "storage/private/learner-accounts",
        "enablement_flag": "BOARDPREP_ACCOUNTS_ENABLED=false",
        "production_routes": "NOT_REGISTERED",
        "credential_backup": "EXCLUDED_UNTIL_ENCRYPTED_BACKUP_AND_RESTORE_REVIEW",
        "data_linking": "NOT_IMPLEMENTED_ANONYMOUS_AND_ACCOUNT_IDENTITIES_REMAIN_SEPARATE"
    },
    "database_modes": [
        "json",
        "sqlite"
    ],
    "health_command": "php tools/doctor.php --health --portfolio --json",
    "release_command": "php tools/doctor.php --release --json",
    "preflight_command": "php tools/doctor.php --preflight --json",
    "smoke_command": "php tools/doctor.php --smoke --json",
    "backup_scope": "mutable_runtime_state_only",
    "production_data_excluded_from_package": [
        "storage/attempts.json",
        "storage/weakness.json",
        "storage/question-statistics.json",
        "storage/flashcard_state.json",
        "storage/runtime",
        "storage/private/learner-accounts",
        ".env"
    ],
    "backup_command": "php tools/backup.php --output=/path/to/backup",
    "restore_command": "php tools/restore.php --input=/path/to/backup --destination=/path/to/restore --dry-run"
}
